# Hugging Face username whose repositories are imported, e.g. HF_USERNAME=your-username
# If left empty, the account of the connected token is used.
HF_USERNAME=

# Optional: fine-grained access token (https://huggingface.co/settings/tokens).
# Required permissions (User permissions):
#   - Collections: "Write access to all collections"
#   - Repositories: "Read access to contents of all repos" (to include private repos)
# If omitted, paste a token on the connection screen instead (kept in server memory only).
# Never commit your real .env file.
HF_TOKEN=

# Local server address. Keep 127.0.0.1 so the proxy is not exposed on your network.
HOST=127.0.0.1
PORT=5173

# Advanced: Hub endpoint (e.g. a mirror). Defaults to https://huggingface.co
# HF_ENDPOINT=https://huggingface.co

# Advanced: extra Host header values to accept (comma separated) if you put the
# server behind a reverse proxy. Requests for other hosts are refused.
# ALLOWED_HOSTS=
